# ---- Required ----
# Get a key at https://aistudio.google.com/apikey  (server-side only, never expose to the browser)
# Copy this file to .env.local and replace the placeholder with your real key.
GEMINI_API_KEY=your_fresh_key
GEMINI_MODEL=gemini-2.5-flash

# ---- Optional: Gemini ----
# GEMINI_MODEL=gemini-2.5-flash

# ---- Optional: uploads (used by both client and server) ----
NEXT_PUBLIC_MAX_UPLOAD_MB=5

# ---- Job search provider ----
# One of: adzuna | remotive | mock   (default: adzuna if keys are set, otherwise remotive)
# JOB_PROVIDER=adzuna

# Adzuna (https://developer.adzuna.com/) - free API keys
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Adzuna country code: gb, us, in, au, ca, de, fr, ... (default: us)
ADZUNA_COUNTRY=us
